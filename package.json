{
	"name": "@local/pi-learn",
	"version": "0.1.0",
	"private": true,
	"description": "A teaching/learning system for pi: a teaching philosophy skill, structured question and graded quiz tools, markdown session logging, and subagent-driven visualization.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-skill"
	],
	"type": "module",
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions/teach-ask.ts",
			"./extensions/teach-quiz.ts",
			"./extensions/md-log.ts"
		],
		"skills": [
			"./skills/teach",
			"./skills/visualize"
		]
	},
	"pi-subagents": {
		"agents": [
			"./agents"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"scripts": {
		"test": "node --test tests/"
	},
	"dependencies": {
		"@mermaid-js/mermaid-cli": "^11.17.0"
	}
}
